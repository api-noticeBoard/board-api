<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.portfolio.board.api.mapper.CategoryMapper">
    <resultMap id="categoryResultMap" type="com.portfolio.board.api.dto.CategoryDto$Response">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="parentId" column="parent_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="modifiedAt" column="modified_at"/>
        <result property="createdByName" column="created_by_Name"/>
        <result property="modifiedByName" column="modified_by_Name"/>
    </resultMap>
    <!-- ========== 계층 구조(트리) 조회용 resultMap 및 재귀 쿼리 ========== -->
    <!--
        findChildrenByParentId select 쿼리를 재귀로 만들어 collection에 넣어줌
        MyBatis가 그룹핑을 통해 계층 구조를 자동으로 조립해 줍니다.
    -->
    <resultMap id="categoryTreeResultMap" type="com.portfolio.board.api.dto.CategoryDto$TreeResponse">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <collection property="children" ofType="com.portfolio.board.api.dto.CategoryDto$TreeResponse"
                    column="id" select="findChildrenByParentId">
            <id property="id" column="child_id"/>
            <result property="name" column="child_name"/>
        </collection>
    </resultMap>

    <select id="findCategoryTree" resultMap="categoryTreeResultMap">
        SELECT
            id,
            name
        FROM category
        WHERE
            parent_id IS NULL
        ORDER BY
            id ASC
    </select>
    <select id="findChildrenByParentId" resultMap="categoryTreeResultMap">
        SELECT
            id,
            name
        FROM category
        WHERE
            parent_id = #{parentId}
        ORDER BY
            id ASC
    </select>
