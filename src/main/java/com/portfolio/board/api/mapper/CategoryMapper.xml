    <select id="searchCategoryByKeywordXml" parameterType="string" resultMap="categoryResultMap">
        SELECT
            a.id
            , a.name
            , a.created_at
            , a.modified_at
            , a.parent_id
            , b.name            AS created_by_Name
            , c.name            AS modified_by_Name
        FROM category a
        LEFT JOIN MEMBER b ON a.created_by = b.id
        LEFT JOIN MEMBER c ON a.modified_by = c.id
        WHERE UPPER(a.name) LIKE CONCAT('%', UPPER(#{keyword}), '%')
            OR UPPER(a.id) LIKE CONCAT('%', UPPER(#{keyword}), '%')
        ORDER BY a.created_at DESC
    </select>
    <select id="findByName" parameterType="string" resultMap="categoryResultMap">
        SELECT
        a.id
        , a.name
        , a.created_at
        , a.modified_at
        , a.parent_id
        , b.name            AS created_by_Name
        , c.name            AS modified_by_Name
        FROM category a
        LEFT JOIN MEMBER b ON a.created_by = b.id
        LEFT JOIN MEMBER c ON a.modified_by = c.id
        WHERE UPPER(a.name) LIKE CONCAT('%', UPPER(#{categoryName}), '%')
        ORDER BY a.created_at DESC
    </select>
    <select id="findById" parameterType="Long" resultMap="categoryResultMap">
        SELECT
        a.id
        , a.name
        , a.created_at
        , a.modified_at
        , a.parent_id
        , b.name            AS created_by_Name
        , c.name            AS modified_by_Name
        FROM category a
        LEFT JOIN MEMBER b ON a.created_by = b.id
        LEFT JOIN MEMBER c ON a.modified_by = c.id
        WHERE a.id = #{categoryId}
        ORDER BY a.created_at DESC
    </select>

</mapper>